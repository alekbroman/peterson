---
import { ArrowRight, ChevronDown } from "@lucide/astro";

const formEndpoint = import.meta.env.PUBLIC_BASIN_GENERAL_ENDPOINT?.trim();
const formReady = Boolean(formEndpoint);
const phoneDisplay = "218-355-0992";
const focusRing =
  "focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-burgundy";
const inputClass =
  "min-h-14 w-full rounded-xl border border-line bg-white px-4 py-3 text-base text-ink caret-burgundy outline-none transition-colors placeholder:text-muted hover:border-muted focus:border-burgundy focus:ring-2 focus:ring-burgundy/18 aria-invalid:border-burgundy aria-invalid:bg-[#fff8fa]";
const selectClass = `${inputClass} appearance-none pr-12`;
const fieldLabel = "mb-2 block font-semibold text-ink";
const errorClass =
  "mt-2 hidden text-sm font-medium text-burgundy data-[visible]:block";
const sectionTitle =
  "font-display text-[clamp(2rem,3.2vw,3rem)] font-bold leading-none tracking-[-0.03em] text-ink";
---

<form
  class="min-w-0"
  action={formReady ? formEndpoint : undefined}
  method="post"
  novalidate
  data-validated-form
  data-form-ready={String(formReady)}
>
  <input type="hidden" name="request_type" value="General inquiry" />
  <div class="hidden" aria-hidden="true">
    <label for="general-company-website">Leave this field empty</label>
    <input
      id="general-company-website"
      name="_gotcha"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div
    class="mb-8 hidden rounded-xl border border-burgundy bg-[#fff8fa] px-4 py-3 font-medium text-burgundy data-[visible]:block"
    role="alert"
    data-form-errors
  >
    Review the marked fields and add the missing information.
  </div>

  <section aria-labelledby="general-question-title">
    <h3 class={sectionTitle} id="general-question-title">
      What can we help with?
    </h3>
    <p class="mt-3 max-w-[45rem] text-muted">
      Ask about an existing project, our services, materials, or anything else
      you need help with.
    </p>
    <div class="mt-7 grid gap-7">
      <div>
        <label class={fieldLabel} for="general-topic">
          Topic
        </label>
        <div class="relative">
          <select
            class={selectClass}
            id="general-topic"
            name="topic"
            required
            aria-describedby="general-topic-error"
            data-error-message="Choose the topic that best fits your question."
          >
            <option value="">Choose a topic</option>
            <option>Existing project</option>
            <option>General service question</option>
            <option>Materials question</option>
            <option>Contractor or business inquiry</option>
            <option>Something else</option>
          </select>
          <ChevronDown
            class="pointer-events-none absolute top-1/2 right-4 w-5 -translate-y-1/2 text-burgundy"
            stroke-width={2.2}
            aria-hidden="true"
          />
        </div>
        <p
          class={errorClass}
          id="general-topic-error"
          data-error-for="general-topic"
        ></p>
      </div>
      <div>
        <label class={fieldLabel} for="general-message">
          Your question
        </label>
        <textarea
          class:list={[inputClass, "min-h-44 resize-y"]}
          id="general-message"
          name="message"
          placeholder="Share the details we need to understand your question."
          required
          aria-describedby="general-message-error"
          data-error-message="Enter your question or message."
        ></textarea>
        <p
          class={errorClass}
          id="general-message-error"
          data-error-for="general-message"
        ></p>
      </div>
    </div>
  </section>

  <section
    class="mt-14 border-t border-line pt-8"
    aria-labelledby="general-contact-title"
  >
    <h3 class={sectionTitle} id="general-contact-title">
      How to reach you
    </h3>
    <div class="mt-7 grid grid-cols-2 gap-x-5 gap-y-7 max-[48rem]:grid-cols-1">
      <div>
        <label class={fieldLabel} for="general-name">
          Name
        </label>
        <input
          class={inputClass}
          id="general-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          aria-describedby="general-name-error"
          data-error-message="Enter your name."
        />
        <p
          class={errorClass}
          id="general-name-error"
          data-error-for="general-name"
        ></p>
      </div>
      <div>
        <label class={fieldLabel} for="general-phone">
          Phone
        </label>
        <input
          class={inputClass}
          id="general-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          required
          aria-describedby="general-phone-error"
          data-error-message="Enter a phone number where we can reach you."
        />
        <p
          class={errorClass}
          id="general-phone-error"
          data-error-for="general-phone"
        ></p>
      </div>
      <div class="col-span-2 max-[48rem]:col-span-1">
        <label class={fieldLabel} for="general-email">
          Email <span class="font-normal text-muted">(optional)</span>
        </label>
        <input
          class={inputClass}
          id="general-email"
          name="email"
          type="email"
          autocomplete="email"
          aria-describedby="general-email-error"
          data-error-message="Enter a complete email address."
        />
        <p
          class={errorClass}
          id="general-email-error"
          data-error-for="general-email"
        ></p>
      </div>
    </div>

    <fieldset class="mt-7 border-0 p-0" data-required-group>
      <legend class={fieldLabel}>Preferred contact method</legend>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        {[
          ["Call", "general-preference-call"],
          ["Text", "general-preference-text"],
          ["Email", "general-preference-email"],
        ].map(([label, id]) => (
          <label
            class="flex min-h-11 cursor-pointer items-center gap-3 font-medium"
            for={id}
          >
            <input
              class="h-5 w-5 accent-burgundy"
              id={id}
              type="radio"
              name="contact_preference"
              value={label}
            />
            {label}
          </label>
        ))}
      </div>
      <p class={errorClass} data-group-error>
        Choose how you would prefer to be contacted.
      </p>
    </fieldset>
  </section>

  <div class="mt-12 border-t border-line pt-8">
    {formReady ? (
      <>
        <p class="mb-5 max-w-[44rem] text-sm text-muted">
          By sending your question, you agree that Peterson Excavating &
          Landscaping may contact you about your question.
        </p>
        <button
          class:list={[
            "inline-flex min-h-15 items-center justify-center gap-3 rounded-xl bg-burgundy px-6 py-4 font-semibold text-white transition-colors hover:bg-burgundy/95 disabled:cursor-wait disabled:opacity-65 max-[48rem]:w-full",
            focusRing,
          ]}
          type="submit"
          data-pending-label="Sending your question…"
        >
          Send your question
          <ArrowRight class="w-5" stroke-width={1.8} aria-hidden="true" />
        </button>
      </>
    ) : (
      <div class="rounded-2xl border border-line bg-stone/55 p-5">
        <p class="m-0 font-semibold text-ink">
          Online submission is being connected.
        </p>
        <p class="mt-2 mb-0 text-muted">
          The form is ready for review. Until the secure submission service is
          configured, please call or text {phoneDisplay}.
        </p>
        <button
          class="mt-5 inline-flex min-h-14 cursor-not-allowed items-center gap-3 rounded-xl bg-charcoal px-5 text-white/55"
          type="submit"
          disabled
        >
          Send your question
          <ArrowRight class="w-5" stroke-width={1.8} aria-hidden="true" />
        </button>
      </div>
    )}
  </div>
</form>
